<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/edit-project/<%= project.id %>" method="POST">
        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
                <% organizations.forEach(org => { %>
                    <option
                        value="<%= org.id %>"
                        <%= Number(org.id) === Number(project.organization_id) ? 'selected' : '' %>
                    >
                        <%= org.name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <div class="form-group">
            <label for="title">Title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= project.title %>"
                required
                maxlength="200"
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                required
                maxlength="1000"
            ><%= project.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= project.location %>"
                required
                maxlength="200"
            />
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= project.date instanceof Date
                    ? project.date.toISOString().slice(0, 10)
                    : String(project.date).slice(0, 10) %>"
                required
            />
        </div>

        <button type="submit">Update Project</button>
    </form>
</main>
<%- include('partials/footer') %>