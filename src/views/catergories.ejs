<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <p class="lede">Browse the different catergories of service projects.</p>

        <ul class="category-list">
            <% if (catergories && catergories.length> 0) { %>
                <% catergories.forEach(category=> { %>
                    <li class="category-item">
                        <%= category.name %>
                    </li>
                    <% }) %>
                        <% } else { %>
                            <li>No catergories found.</li>
                            <% } %>
        </ul>
    </main>

    <%- include('partials/footer') %>