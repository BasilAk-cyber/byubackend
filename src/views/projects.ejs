<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <p class="lede">Current and upcoming volunteer opportunities across our partner organizations.</p>

        <ul class="project-list">
            <li class="project-row">
                <span class="status status-ongoing">Ongoing</span>
                <div class="project-info">
                    <h2>After-School Mentorship Program</h2>
                    <p class="project-org">Bright Future</p>
                    <p>Weekly tutoring sessions pairing volunteers with middle schoolers on reading and math.</p>
                </div>
            </li>
            <li class="project-row">
                <span class="status status-ongoing">Ongoing</span>
                <div class="project-info">
                    <h2>Community Garden Initiative</h2>
                    <p class="project-org">Green Harvest</p>
                    <p>Planting, weeding, and harvesting shifts at three neighborhood garden plots.</p>
                </div>
            </li>
            <li class="project-row">
                <span class="status status-upcoming">Upcoming</span>
                <div class="project-info">
                    <h2>Winter Coat Drive</h2>
                    <p class="project-org">Unity Serve</p>
                    <p>Sorting and distributing donated winter coats ahead of the first cold snap.</p>
                </div>
            </li>
        </ul>
    </main>

    <%- include('partials/footer') %>