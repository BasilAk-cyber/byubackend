<%- include('partials/header') %>

<main>
    <h1><%= project.title %></h1>
    <p><%= project.description %></p>
    <p>Date: <%= project.date %></p>
    <p>Location: <%= project.location %></p>
    <p>
        Organization:
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <% if (categories && categories.length > 0) { %>
        <p class="tags">
            <% categories.forEach(category => { %>
                <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
            <% }) %>
        </p>
    <% } %>
</main>

<% if (user && user.role_name === 'admin') { %>
    <p>
        <a href="/project/<%= project.project_id %>/assign-categories">Edit Categories</a>
    </p>

    <p>
        <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
    </p>
<% } %>
<% if (user) { %>
    <% if (isVolunteer) { %>
        <p>You are volunteering for this project.</p>
        <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
            <button type="submit">Remove me as a volunteer</button>
        </form>
    <% } else { %>
        <form action="/project/<%= project.project_id %>/volunteer" method="POST">
            <button type="submit">Volunteer for this project</button>
        </form>
    <% } %>
<% } %>

<%- include('partials/footer') %>