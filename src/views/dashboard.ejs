<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/users">View all users</a></p>
    <% } %>

    <h2>Projects You're Volunteering For</h2>

<% if (volunteerProjects && volunteerProjects.length > 0) { %>
    <ul>
        <% volunteerProjects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                (<%= project.organization_name %>,
                <%= new Date(project.date).toLocaleDateString('en-US', {
                    year: 'numeric', month: 'long', day: 'numeric'
                }) %>)
                <form action="/project/<%= project.project_id %>/unvolunteer" method="POST" style="display:inline;">
                    <input type="hidden" name="from" value="dashboard">
                    <button type="submit">Remove</button>
                </form>
            </li>
        <% }) %>
    </ul>
<% } else { %>
    <p>You haven't volunteered for any projects yet.</p>
<% } %>

</main>


<%- include('partials/footer') %>